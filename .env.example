# RemoteAgent deployment identity
COMPOSE_PROJECT_NAME=remoteagent
REMOTEAGENT_INSTANCE_ID=remoteagent
REMOTEAGENT_VERSION=local
REMOTEAGENT_BIND_ADDRESS=0.0.0.0
REMOTEAGENT_PORT=8080
REMOTEAGENT_LOG_LEVEL=INFO
REMOTEAGENT_CRON_LOG_LEVEL=INFO

# `scripts/remotectl init` replaces these with absolute host paths. Docker
# Compose launched inside the router must see the same paths as the host daemon.
REMOTEAGENT_REPO_ROOT=/absolute/path/to/RemoteAgent
REMOTEAGENT_STATE_ROOT=/absolute/path/to/RemoteAgent/.runtime
REMOTEAGENT_DOCKER_SOCKET=/var/run/docker.sock
REMOTEAGENT_DOCKER_GID=998
REMOTEAGENT_UID=1000
REMOTEAGENT_GID=1000
# Network used only by Dockerfile RUN steps. `host` can be selected on a
# dedicated Linux builder whose bridge network cannot reach package mirrors.
REMOTEAGENT_BUILD_NETWORK=default

# Durable backing services. Passwords and bearer tokens live under
# .runtime/secrets and are mounted as Docker Compose secrets.
POSTGRES_DB=remoteagent
POSTGRES_USER=remoteagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Stable cross-project volume names used by every agent Compose project.
REMOTEAGENT_AUTH_VOLUME=remoteagent-codex-auth
REMOTEAGENT_SKILLS_VOLUME=remoteagent-common-skills

# Router/runtime behavior
REMOTEAGENT_PHONEBOOK_PATH=/opt/remoteagent/repository/phonebook.toml
REMOTEAGENT_SCHEDULER_CONCURRENCY=4
REMOTEAGENT_JOB_TIMEOUT_SECONDS=14400
REMOTEAGENT_ARTIFACT_MAX_FILE_BYTES=104857600
REMOTEAGENT_COMPANION_MAX_OBJECT_BYTES=104857600
REMOTEAGENT_COMPANION_MAX_FILES_PER_ITEM=20000
REMOTEAGENT_COMPANION_MAX_PER_TURN=20
REMOTEAGENT_COMPANION_MAX_ACTIVE_NAMES=200
REMOTEAGENT_COMPANION_MAX_CONVERSATION_BYTES=1073741824
REMOTEAGENT_COMPANION_STAGING_MAX_BYTES=5368709120
REMOTEAGENT_COMPANION_STAGE_TTL_SECONDS=86400
REMOTEAGENT_COMPANION_GIT_WORKERS=2
REMOTEAGENT_COMPANION_GIT_TIMEOUT_SECONDS=300
REMOTEAGENT_DEPENDENCY_WARM_SECONDS=900
REMOTEAGENT_MCP_PATH=/mcp
# `remotectl init` merges this safe localhost baseline with the server's
# hostname, FQDN, and interface addresses. Keep JSON inside shell quotes.
REMOTEAGENT_MCP_ALLOWED_HOSTS='["127.0.0.1:*","localhost:*","[::1]:*","router:8080"]'
REMOTEAGENT_MCP_ALLOWED_ORIGINS='["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]'
REMOTEAGENT_DASHBOARD_ENABLED=true
# V1 is intentionally HTTP-only on a trusted internal network. Set false after
# placing the router behind a TLS reverse proxy.
REMOTEAGENT_DASHBOARD_ALLOW_HTTP=true
REMOTEAGENT_DASHBOARD_DEBUG_ENABLED=false
REMOTEAGENT_DASHBOARD_SESSION_IDLE_SECONDS=1800
REMOTEAGENT_DASHBOARD_SESSION_ABSOLUTE_SECONDS=28800

# Optional future API-key mode. Do not put a key here; use
# `scripts/remotectl auth login --method api --key-file ...`.
REMOTEAGENT_AUTH_MODE=chatgpt

# Internal cron scheduler. Its API is not published on the host. Authentication
# values are generated as files under .runtime/secrets by `remotectl init`.
REMOTEAGENT_CRON_TICK_SECONDS=1
REMOTEAGENT_CRON_JOB_POLL_SECONDS=5
REMOTEAGENT_CRON_ROUTER_REQUEST_TIMEOUT_SECONDS=30
REMOTEAGENT_CRON_RETRY_INITIAL_SECONDS=0.5
REMOTEAGENT_CRON_RETRY_MAX_SECONDS=30
REMOTEAGENT_CRON_LEASE_SECONDS=300
REMOTEAGENT_CRON_RESPONSE_RETENTION_SECONDS=7776000
REMOTEAGENT_CRON_ACK_TOMBSTONE_SECONDS=86400
REMOTEAGENT_CRON_RESPONSE_BATCH_LIMIT=50
REMOTEAGENT_CRON_RESPONSE_BATCH_BYTES=4194304
REMOTEAGENT_CRON_RUN_TIMEOUT_SECONDS=86400
REMOTEAGENT_CRON_EXECUTION_RETENTION_SECONDS=2592000
REMOTEAGENT_CRON_CLEANUP_INTERVAL_SECONDS=3600
