            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CronBearerAuth": []
          }
        ],
        "summary": "Delete Schedule",
        "tags": [
          "Schedules"
        ]
      },
      "get": {
        "operationId": "cronScheduleGet",
        "parameters": [
          {
            "in": "path",
            "name": "schedule_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "title": "Schedule Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CronBearerAuth": []
          }
        ],
        "summary": "Get Schedule",
        "tags": [
          "Schedules"
        ]
      },
      "put": {
        "operationId": "cronScheduleConfigure",
        "parameters": [
          {
            "in": "path",
            "name": "schedule_id",
            "required": true,
            "schema": {
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "title": "Schedule Id",
              "type": "string"
            }
