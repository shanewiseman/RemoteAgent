{
  "components": {
    "schemas": {
      "AcknowledgeResponsesRequest": {
        "additionalProperties": false,
        "properties": {
          "lease_id": {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Lease Id",
            "type": "string"
          }
        },
        "required": [
          "lease_id"
        ],
        "title": "AcknowledgeResponsesRequest",
        "type": "object"
      },
      "AcknowledgeResponsesResult": {
        "properties": {
          "deleted_count": {
            "minimum": 0.0,
            "title": "Deleted Count",
            "type": "integer"
          },
          "lease_id": {
            "title": "Lease Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "acknowledged",
              "already_acknowledged",
              "stale"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "lease_id",
          "status",
          "deleted_count"
        ],
        "title": "AcknowledgeResponsesResult",
        "type": "object"
      },
      "ConfigureScheduleRequest": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
            "title": "Agent Id",
            "type": "string"
          },
          "conversation_mode": {
            "$ref": "#/components/schemas/ConversationMode",
            "default": "fresh"
          },
          "cron_expression": {
            "maxLength": 255,
            "minLength": 9,
            "title": "Cron Expression",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "prompt": {
            "maxLength": 2000000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReasoningEffort"
              },
              {
                "type": "null"
              }
            ]
          },
          "timezone": {
            "default": "UTC",
            "maxLength": 128,
            "minLength": 1,
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "cron_expression",
          "agent_id",
          "prompt"
        ],
        "title": "ConfigureScheduleRequest",
        "type": "object"
      },
      "ConversationMode": {
        "enum": [
          "fresh",
          "persistent"
        ],
        "title": "ConversationMode",
        "type": "string"
      },
      "CronResponse": {
        "properties": {
          "agent_id": {
            "title": "Agent Id",
            "type": "string"
          },
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "conversation_key": {
            "title": "Conversation Key",
            "type": "string"
          },
          "execution_id": {
            "title": "Execution Id",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReasoningEffort"
              },
              {
                "type": "null"
              }
            ]
          },
          "response_id": {
            "title": "Response Id",
            "type": "string"
          },
          "result": {
            "title": "Result",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "revision_id": {
            "title": "Revision Id",
            "type": "string"
          },
          "router_job_id": {
            "title": "Router Job Id",
            "type": "string"
          },
          "schedule_id": {
            "title": "Schedule Id",
            "type": "string"
          },
          "scheduled_for": {
            "format": "date-time",
            "title": "Scheduled For",
            "type": "string"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UsageTotals"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "response_id",
          "schedule_id",
          "execution_id",
          "revision_id",
          "revision",
          "agent_id",
          "router_job_id",
          "conversation_key",
          "scheduled_for",
          "completed_at",
          "model",
          "reasoning_effort",
          "usage",
          "result"
        ],
        "title": "CronResponse",
        "type": "object"
      },
      "DeleteScheduleResult": {
        "properties": {
          "schedule_id": {
            "title": "Schedule Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "deleted",
              "deleting"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "schedule_id",
          "status"
        ],
        "title": "DeleteScheduleResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LastFailure": {
        "properties": {
          "completed_at": {
            "format": "date-time",
            "title": "Completed At",
            "type": "string"
          },
          "error": {
            "title": "Error",
            "type": "string"
          },
          "execution_id": {
            "title": "Execution Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "execution_id",
          "status",
          "error",
          "completed_at"
        ],
        "title": "LastFailure",
        "type": "object"
      },
      "LeaseResponsesRequest": {
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "anyOf": [
              {
                "maxLength": 36,
                "minLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Id"
          },
          "limit": {
            "default": 50,
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "schedule_id": {
            "anyOf": [
              {
                "maxLength": 63,
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schedule Id"
          }
        },
        "title": "LeaseResponsesRequest",
        "type": "object"
      },
      "ReasoningEffort": {
        "enum": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ],
        "title": "ReasoningEffort",
        "type": "string"
      },
      "ResponseLease": {
        "properties": {
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "lease_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lease Id"
          },
          "more_available": {
            "title": "More Available",
            "type": "boolean"
          },
          "responses": {
            "items": {
              "$ref": "#/components/schemas/CronResponse"
            },
            "title": "Responses",
            "type": "array"
          }
        },
        "required": [
          "lease_id",
          "expires_at",
          "responses",
          "more_available"
        ],
        "title": "ResponseLease",
        "type": "object"
      },
      "ScheduleView": {
        "properties": {
          "active_execution_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Execution Id"
          },
          "agent_id": {
            "title": "Agent Id",
            "type": "string"
          },
          "conversation_mode": {
            "$ref": "#/components/schemas/ConversationMode"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "cron_expression": {
            "title": "Cron Expression",
            "type": "string"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "generation_id": {
            "title": "Generation Id",
            "type": "string"
          },
          "last_execution_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Execution Id"
          },
          "last_failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LastFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "next_fire_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Fire At"
          },
          "pending_response_count": {
            "minimum": 0.0,
            "title": "Pending Response Count",
            "type": "integer"
          },
          "prompt": {
            "title": "Prompt",
            "type": "string"
          },
          "reasoning_effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReasoningEffort"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "revision_id": {
            "title": "Revision Id",
            "type": "string"
          },
          "schedule_id": {
            "title": "Schedule Id",
            "type": "string"
          },
          "skipped_occurrences": {
            "minimum": 0.0,
            "title": "Skipped Occurrences",
            "type": "integer"
          },
          "status": {
            "enum": [
              "enabled",
              "disabled",
              "deleting"
            ],
            "title": "Status",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "schedule_id",
          "generation_id",
          "status",
          "enabled",
          "cron_expression",
          "timezone",
          "agent_id",
          "prompt",
          "model",
          "reasoning_effort",
          "conversation_mode",
          "revision",
          "revision_id",
          "next_fire_at",
          "active_execution_id",
          "last_execution_id",
          "pending_response_count",
          "skipped_occurrences",
          "last_failure",
          "created_at",
          "updated_at"
        ],
        "title": "ScheduleView",
        "type": "object"
      },
      "SetScheduleEnabledRequest": {
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "SetScheduleEnabledRequest",
        "type": "object"
      },
      "UsageTotals": {
        "additionalProperties": true,
        "properties": {
          "cached_input_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Cached Input Tokens",
            "type": "integer"
          },
          "input_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "reasoning_output_tokens": {
            "default": 0,
            "minimum": 0.0,
            "title": "Reasoning Output Tokens",
            "type": "integer"
          }
        },
        "title": "UsageTotals",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CronBearerAuth": {
        "description": "Router-to-cron internal service token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "RemoteAgent Cron Internal API",
    "version": "0.2.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/v1/responses/acknowledge": {
      "post": {
        "operationId": "cronResponsesAcknowledge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeResponsesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcknowledgeResponsesResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CronBearerAuth": []
          }
        ],
        "summary": "Acknowledge Responses",
        "tags": [
          "Responses"
        ]
      }
    },
    "/internal/v1/responses/lease": {
      "post": {
        "operationId": "cronResponsesLease",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaseResponsesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseLease"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CronBearerAuth": []
          }
        ],
        "summary": "Lease Responses",
        "tags": [
          "Responses"
        ]
      }
    },
    "/internal/v1/schedules": {
      "get": {
        "operationId": "cronSchedulesList",
        "parameters": [
          {
            "in": "query",
            "name": "include_disabled",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Disabled",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScheduleView"
                  },
                  "title": "Response Cronscheduleslist",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "CronBearerAuth": []
          }
        ],
        "summary": "List Schedules",
        "tags": [
          "Schedules"
        ]
      }
    },
    "/internal/v1/schedules/{schedule_id}": {
